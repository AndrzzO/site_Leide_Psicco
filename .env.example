# ============================================================
# .env.example — INSTITUTO MENTE EM FOCO
# Modelo de configuração de variáveis de ambiente
# Copie este arquivo para .env e preencha conforme seu ambiente
# NUNCA ENVIE O ARQUIVO .env COM CREDENCIAIS REAIS PARA O GIT
# ============================================================

# Módulo de configurações (desenvolvimento ou producao)
DJANGO_SETTINGS_MODULE=configuracoes.settings.desenvolvimento

# Chave secreta do Django (Obrigatória em produção; gere uma chave segura, única e com mais de 50 caracteres)
DJANGO_SECRET_KEY=

# Modo de depuração (True em desenvolvimento local; rigorosamente False em produção)
DJANGO_DEBUG=True

# Hosts autorizados (separados por vírgula, sem espaços e sem wildcard *)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Origens confiáveis para submissão CSRF (separadas por vírgula, incluindo esquema https:// em produção)
DJANGO_CSRF_TRUSTED_ORIGINS=

# URL do banco de dados (em branco para SQLite local; em produção ex: postgres://usuario:senha@host:5432/nomedobanco)
DATABASE_URL=

# Caminho customizado para o Django Admin (padrão: admin/)
DJANGO_ADMIN_URL=admin/

# Redirecionamento HTTPS e segurança SSL (True apenas em ambiente com certificado TLS/SSL ativo)
DJANGO_SECURE_SSL_REDIRECT=False

# HSTS - HTTP Strict Transport Security
# Rollout seguro: mantenha 0 até validar o domínio e o HTTPS.
# Após validação: 300 (5 min) -> 86400 (1 dia) -> 31536000 (1 ano).
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Proxy Reverso: definir como True SOMENTE se a aplicação estiver atrás de um reverse proxy
# confiável (ex: Nginx, Render, Railway, AWS ALB) que encerre o TLS e injete X-Forwarded-Proto
DJANGO_SECURE_PROXY_SSL_HEADER=False

# Content Security Policy (CSP): ativar True para usar Content-Security-Policy-Report-Only em homologação
DJANGO_SECURE_CSP_REPORT_ONLY=False

# Proteção contra Abuso e Rate Limiting (Prompt 17)
# Limites do Formulário de Contato (POST: submissões por janela em segundos)
CONTACT_RATE_LIMIT_COUNT=5
CONTACT_RATE_LIMIT_WINDOW=900

# Limites do Login Administrativo (POST: tentativas falhas por janela em segundos)
ADMIN_LOGIN_IP_LIMIT=10
ADMIN_LOGIN_IP_WINDOW=900
ADMIN_LOGIN_IP_BLOCK=900

ADMIN_LOGIN_COMBO_LIMIT=5
ADMIN_LOGIN_COMBO_WINDOW=900
ADMIN_LOGIN_COMBO_BLOCK=900

# Confiança em cabeçalho X-Forwarded-For (SOMENTE ativar atrás de proxy reverso homologado)
TRUST_PROXY_CLIENT_IP=False

# URL pública do site (em produção deve ser a URL canônica com https://)
SITE_URL=http://localhost:8000

# Armazenamento de Arquivos Estáticos com Hash (ManifestStaticFilesStorage)
# Opcional para produção; ative somente se o pipeline de deploy executar collectstatic com sucesso
DJANGO_MANIFEST_STATIC_STORAGE=False

# ============================================================
# SERVIÇO DE E-MAIL (SMTP) — CONFIGURAÇÃO DE PRODUÇÃO
# ============================================================
# Backend de envio (em desenvolvimento o padrão é console; em produção, smtp)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ============================================================
# CONFIGURAÇÕES INSTITUCIONAIS (PENDENTES DE DEFINIÇÃO PELO CLIENTE)
# ============================================================
WHATSAPP_NUMERO=PENDENTE_DEFINICAO
EMAIL_CONTATO=PENDENTE_DEFINICAO
INSTAGRAM_URL=PENDENTE_DEFINICAO
CRP_PROFISSIONAL=PENDENTE_DEFINICAO

# ============================================================
# GOVERNANÇA DE DADOS E RETENÇÃO (LGPD)
# ============================================================
# Prazo em dias para expiração e descarte de mensagens de contato (ex: 90, 180, 365).
# Se deixado em branco ou não configurado, NENHUMA exclusão automática é realizada.
CONTATO_RETENCAO_DIAS=

# ============================================================
# GOVERNANÇA DE SEO E INDEXAÇÃO
# ============================================================
# Permissão de indexação em mecanismos de busca (Google, Bing, etc.)
# ATENÇÃO: Mantenha False em desenvolvimento, homologação e pré-lançamento.
# Ative apenas em produção com domínio oficial configurado e HTTPS ativo.
SEO_ALLOW_INDEXING=False

# Verificação de Propriedade do Domínio (Opcional - insira o código fornecido pelos buscadores)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
